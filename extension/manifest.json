{
  "manifest_version": 3,
  "name": "RECLAIM",
  "version": "1.0.0",
  "description": "Privacy-focused digital exposure monitor and personal data footprint manager.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RECLAIM Privacy Exposure Monitor"
  }
}
